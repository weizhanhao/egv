{
  "$schema": "../SCHEMA.md",
  "project_name": "excalidraw",
  "project_root": "/Users/weizhanhao/fortest/poc/excalidraw",
  "framework": "vitest+playwright",
  "framework_config": {
    "test_runner": "vitest",
    "coverage_command": "yarn test:coverage --run --reporter=json",
    "coverage_output_path": "coverage/coverage-final.json",
    "typecheck_command": "yarn test:typecheck",
    "test_file_pattern": "**/*.test.{ts,tsx}",
    "sentinel_test_command": "yarn test:app --run {test_path}"
  },
  "critical_flows": [
    {
      "name": "draw-shape-via-drag",
      "description": "User drags on canvas to create rectangle/ellipse/diamond \u2014 the most fundamental excalidraw interaction. If this breaks, the product is dead.",
      "category": "core-creation",
      "test_path": "packages/excalidraw/tests/dragCreate.test.tsx",
      "owning_code_paths": [
        "packages/excalidraw/components/App.tsx",
        "packages/element/src/newElement.ts",
        "packages/excalidraw/scene/Renderer.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "draw-multi-point-shape",
      "description": "User creates linear element (line, arrow, freedraw) by clicking multiple points",
      "category": "core-creation",
      "test_path": "packages/excalidraw/tests/multiPointCreate.test.tsx",
      "owning_code_paths": [
        "packages/excalidraw/components/App.tsx",
        "packages/element/src/linearElementEditor.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "select-and-move-shape",
      "description": "User clicks an element, drags to move it. Selection state + position state both involved.",
      "category": "core-interaction",
      "test_path": "packages/excalidraw/tests/move.test.tsx",
      "owning_code_paths": [
        "packages/excalidraw/components/App.tsx",
        "packages/element/src/selection.ts",
        "packages/element/src/mutateElement.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "multi-select-via-drag",
      "description": "User drags an empty area to box-select multiple elements (overlap selection)",
      "category": "core-interaction",
      "test_path": "packages/excalidraw/tests/selection.test.tsx",
      "owning_code_paths": [
        "packages/element/src/selection.ts",
        "packages/element/src/collision.ts",
        "packages/element/src/bounds.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "resize-shape",
      "description": "User drags a resize handle to scale an element",
      "category": "core-interaction",
      "test_path": "packages/element/tests/resize.test.tsx",
      "owning_code_paths": [
        "packages/element/src/resizeElements.ts",
        "packages/element/src/transformHandles.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "undo-redo",
      "description": "Ctrl-Z reverts, Ctrl-Y re-applies. History state machine.",
      "category": "core-interaction",
      "test_path": "packages/excalidraw/tests/history.test.tsx",
      "owning_code_paths": [
        "packages/excalidraw/history.ts",
        "packages/excalidraw/actions/actionHistory.tsx"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "restore-from-data",
      "description": "Load a saved drawing \u2014 restores element list + app state from serialized form. Failure mode: invalid data crashes the editor.",
      "category": "persistence",
      "test_path": "packages/excalidraw/tests/data/restore.test.ts",
      "owning_code_paths": [
        "packages/excalidraw/data/restore.ts",
        "packages/math/src/point.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    },
    {
      "name": "export-to-image",
      "description": "Export drawing as PNG/SVG. End-to-end render pipeline.",
      "category": "output",
      "test_path": "packages/excalidraw/tests/export.test.tsx",
      "owning_code_paths": [
        "packages/excalidraw/scene/export.ts",
        "packages/utils/src/export.ts"
      ],
      "last_verified": null,
      "verified_at_runs": []
    }
  ],
  "flow_code_mappings": [],
  "known_blind_spots": [
    {
      "description": "Excalidraw is a canvas-based SPA with no traditional routes. Layer 3 (route smoke) does not apply. Critical Path Sentinel covers this gap by running the critical_flows tests.",
      "observed_at": "2026-05-28T10:50:00Z"
    },
    {
      "description": "Vitest coverage --reporter=json output structure may include relative paths. coverage-diff.ts must normalize paths against project_root before matching against diff file paths.",
      "observed_at": "2026-05-28T10:50:00Z"
    },
    {
      "description": "Type-only files (.d.ts, types.ts) appear as 'uncovered' in Vitest coverage because they have no runtime statements. This produces FALSE POSITIVES in blast-radius analysis. Discovered during POC run on commit 2dfcc6f0 \u2014 types.ts marked uncovered (17 lines) but all critical flows passed. Sentinel correctly overrode. Future fix: detect type-only files and classify as 'no_runtime_code' (separate from 'uncovered').",
      "observed_at": "2026-05-28T13:00:00Z",
      "discovered_in_run": "20260528T055701Z__2dfcc6f0"
    },
    {
      "description": "Snapshot test files (.test.tsx.snap) are correctly excluded as test_file_excluded by the TEST_FILE_REGEX in coverage-diff.ts, BUT they appear as part of the diff. They're auto-generated artifacts \u2014 changes to them shouldn't trigger any human review concern. Currently we list them in the per-file table which adds noise. Future fix: also exclude .snap files from the visible report or aggregate them under a separate 'snapshot updates' line.",
      "observed_at": "2026-05-28T13:00:00Z",
      "discovered_in_run": "20260528T055701Z__2dfcc6f0"
    },
    {
      "description": "Auditor and Sentinel disagreement is currently 'PASS vs WARN' in 3/3 POC runs because Auditor is strict about any uncovered line (incl. type files) while Sentinel verifies actual behavior. This is the methodology working as designed \u2014 but for v1, consider tuning Auditor to be less alarmist for low-impact uncovered lines (e.g. type-only, snapshot-only, comment-only changes).",
      "observed_at": "2026-05-28T13:00:00Z",
      "discovered_in_run": "all-three-poc-runs"
    }
  ],
